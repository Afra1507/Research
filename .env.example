# Copy this file to .env and fill in real values from Supabase Dashboard.
# Never commit .env

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Supabase CLI / Management API access token
SUPABASE_ACCESS_TOKEN=your_access_token_here

# Postgres connection string (Project Settings → Database)
# Used by FastAPI / SQLAlchemy
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
